        "    def validate_rollup_region_residency(\n",
        "        self, rollup_enabled: bool, data_residency_approved: bool\n",
        "    ) -> str:\n",
        "        if rollup_enabled and not data_residency_approved:\n",
        "            raise PermissionError(\n",
        "                \"LEGAL_VIOLATION: MUST verify international data export and residency laws before enabling Rollup Regions.\"\n",
        "            )\n",
        "        return \"ALLOWED: Security Lake regional rollup compliant with data residency rules.\"\n",
        "\n",
        "    def validate_data_access_path(\n",
        "        self, caller_type: str, caller_account_id: str, via_subscriber_query: bool\n",
        "    ) -> str:\n",
        "        if caller_type == \"HUMAN_USER\" and not via_subscriber_query:\n",
        "            raise PermissionError(\n",
        "                \"DIRECT_S3_BLOCKED: Users MUST NOT directly access Log Archive Security Lake S3 buckets. \"\n",
        "                \"Query via Security Tooling Subscriber.\"\n",
        "            )\n",
        "        if via_subscriber_query and caller_account_id != self.security_tooling_id:\n",
        "            raise PermissionError(\n",
        "                f\"SUBSCRIBER_ERROR: Analyst queries must originate from Security Tooling ({self.security_tooling_id}).\"\n",
        "            )\n",
        "        return \"ALLOWED: Query access properly isolated through Security Tooling Subscriber.\"\n",
        "\n",
        "    def validate_config_change_source(self, change_source: str, scp_blocks_manual_edits: bool) -> str:\n",
