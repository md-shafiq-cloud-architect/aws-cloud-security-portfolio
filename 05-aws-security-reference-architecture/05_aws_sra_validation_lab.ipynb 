        "        with self.assertRaises(ConnectionError):\n",
        "            self.validator.validate_ssm_containment_readiness(\"PROD\", True, {\"ssm\"})\n",
        "\n",
        "    def test_five_phase_lifecycle_and_ai_telemetry(self):\n",
