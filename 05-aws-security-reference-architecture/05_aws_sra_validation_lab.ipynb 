        "\n",
        "class AWSSRAConfigGovernanceValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 31 (AWS Config):\n",
        "    1. Enforces Proactive Mode / cfn-guard Shift-Left validation before deployment.\n",
        "    2. Verifies SSM Automation Runbook remediation for Detective drift findings.\n",
        "    3. Ensures Delivery Channel routes to Log Archive and Aggregator is delegated to Security Tooling.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, security_tooling_id: str, log_archive_id: str):\n",
        "        self.security_tooling_id = security_tooling_id\n",
        "        self.log_archive_id = log_archive_id\n",
        "\n",
        "    def validate_proactive_and_detective_controls(\n",
        "        self, evaluation_mode: str, is_compliant: bool, ssm_runbook_attached: bool\n",
        "    ) -> str:\n",
        "        if evaluation_mode == \"PROACTIVE\":\n",
        "            if not is_compliant:\n",
        "                raise PermissionError(\n",
        "                    \"PROACTIVE_BLOCK: Resource failed AWS Config Proactive / cfn-guard check prior to deployment.\"\n",
        "                )\n",
        "            return \"ALLOWED: Resource passed Proactive / Shift-Left compliance gate.\"\n",
        "\n",
        "        if evaluation_mode == \"DETECTIVE\":\n",
        "            if not is_compliant and not ssm_runbook_attached:\n",
        "                raise RuntimeError(\n",
        "                    \"REMEDIATION_GAP: Non-compliant detective rule requires an AWS Systems Manager Automation runbook.\"\n",
        "                )\n",
        "            return \"ALLOWED: Detective rule verified with SSM Automation auto-remediation.\"\n",
        "\n",
        "        raise ValueError(f\"INVALID_MODE: Unsupported evaluation mode '{evaluation_mode}'.\")\n",
        "\n",
        "    def validate_central_config_architecture(\n",
        "        self,\n",
        "        aggregator_admin_id: str,\n",
        "        delivery_bucket_account_id: str,\n",
        "        rule_tags: dict,\n",
        "        member_attempted_edit: bool,\n",
        "    ) -> str:\n",
        "        if aggregator_admin_id != self.security_tooling_id:\n",
        "            raise PermissionError(\"DELEGATION_ERROR: Config Aggregator must be delegated to Security Tooling Account.\")\n",
        "        if delivery_bucket_account_id != self.log_archive_id:\n",
        "            raise PermissionError(\"ROUTING_ERROR: Config Delivery Channel must target Log Archive Account S3 bucket.\")\n",
        "        if rule_tags.get(\"aws-control-tower\") == \"managed-by-control-tower\" and member_attempted_edit:\n",
        "            raise PermissionError(\n",
        "                \"GUARDRAIL_LOCKED: Member account cannot modify rule tagged 'managed-by-control-tower'.\"\n",
        "            )\n",
        "        return \"ALLOWED: Central Config Aggregator, Log Archive Delivery Channel & Control Tower lock verified.\"\n",
        "\n",
