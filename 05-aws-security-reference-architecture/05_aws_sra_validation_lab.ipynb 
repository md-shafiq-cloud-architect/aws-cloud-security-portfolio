        "\n",
        "    def __init__(self, mgmt_account_id: str, approved_audit_accounts: set):\n",
        "        self.mgmt_account_id = mgmt_account_id\n",
        "        self.approved_audit_accounts = approved_audit_accounts\n",
        "\n",
        "    def validate_artifact_iam_access(\n",
        "        self, caller_account_id: str, iam_role_name: str, allowed_report_resources: list\n",
        "    ) -> str:\n",
        "        if caller_account_id == self.mgmt_account_id:\n",
        "            raise PermissionError(\n",
        "                \"SEPARATION_OF_DUTIES: Org Management Account MUST NOT be used for AWS Artifact operations.\"\n",
        "            )\n",
        "        if caller_account_id not in self.approved_audit_accounts:\n",
        "            raise PermissionError(\n",
        "                f\"ACCOUNT_VIOLATION: Account '{caller_account_id}' is not an approved Security Tooling/Audit account.\"\n",
        "            )\n",
        "        if not iam_role_name.startswith(\"AuditCompliance-\"):\n",
        "            raise PermissionError(\n",
        "                \"ROLE_HYGIENE_VIOLATION: Access must be restricted to dedicated 'AuditCompliance-*' IAM roles.\"\n",
        "            )\n",
        "        if not allowed_report_resources or \"*\" in allowed_report_resources:\n",
        "            raise ValueError(\n",
        "                \"LEAST_PRIVILEGE_VIOLATION: IAM policy must scope access to specific Artifact report ARNs, not '*'.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Fine-grained AWS Artifact access verified in '{caller_account_id}' via '{iam_role_name}'.\"\n",
        "\n",
        "\n",
