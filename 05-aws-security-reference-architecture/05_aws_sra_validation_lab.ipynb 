        "            raise RuntimeError(\n",
        "                f\"SCALE_RISK: {account_count} accounts cannot be managed manually. Enforce CfCT or AFT.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Scale governance verified ({account_count} accounts via {automation_tool}).\"\n",
        "\n",
