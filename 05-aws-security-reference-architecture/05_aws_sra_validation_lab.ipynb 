        "            active_drivers.append(\"Multi-Continent Ultra-Low Latency\")\n",
        "        if self.inputs.global_realtime_performance_required:\n",
        "            active_drivers.append(\"Global Real-Time Performance\")\n",
        "        return active_drivers\n",
        "\n",
        "    def validate_decision_and_guidelines(self) -> Dict[str, object]:\n",
        "        drivers = self.evaluate_multi_region_drivers()\n",
        "        arch = self.inputs.chosen_architecture.lower()\n",
