        "import unittest\n",
        "\n",
        "class AWSSRADelegationValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS Security Reference Architecture (SRA) governance rules:\n",
        "    1. Management Account must host zero production workloads.\n",
        "    2. Trusted Access must be enabled for organization-wide security services.\n",
        "    3. Security services must be delegated to the Security Tooling Account,\n",
        "       while IAM Identity Center is isolated in the Identity Account (Separation of Duties).\n",
        "    \"\"\"\n",
        "\n",
        "    SECURITY_SERVICES = {\n",
        "        \"guardduty\",\n",
        "        \"securityhub\",\n",
        "        \"macie\",\n",
        "        \"inspector2\",\n",
        "        \"detective\",\n",
        "        \"config\",\n",
        "        \"fms\",\n",
        "        \"auditmanager\",\n",
        "        \"access-analyzer\",\n",
        "        \"ssm\",\n",
        "    }\n",
        "\n",
        "    IDENTITY_SERVICE = \"iam-identity-center\"\n",
        "\n",
        "    def __init__(self, mgmt_account_id: str, security_account_id: str, identity_account_id: str):\n",
        "        self.mgmt_account_id = mgmt_account_id\n",
        "        self.security_account_id = security_account_id\n",
        "        self.identity_account_id = identity_account_id\n",
        "\n",
        "    def validate_management_isolation(self, active_workloads: list) -> str:\n",
        "        if active_workloads:\n",
        "            raise PermissionError(\n",
        "                f\"VIOLATION: Management Account ({self.mgmt_account_id}) contains workloads: {active_workloads}\"\n",
        "            )\n",
        "        return \"ALLOWED: Management Account is strictly isolated (Billing & Org management only).\"\n",
        "\n",
        "    def validate_delegation(self, service_name: str, target_account_id: str, trusted_access: bool) -> str:\n",
        "        if not trusted_access:\n",
        "            raise ValueError(f\"BLOCKED: Trusted Access is disabled for {service_name}.\")\n",
        "\n",
        "        if target_account_id == self.mgmt_account_id:\n",
        "            raise PermissionError(\n",
        "                f\"VIOLATION: Do not operate {service_name} directly from Management Account.\"\n",
        "            )\n",
        "\n",
        "        if service_name in self.SECURITY_SERVICES and target_account_id != self.security_account_id:\n",
        "            raise PermissionError(\n",
        "                f\"VIOLATION: {service_name} must be delegated to Security Tooling Account ({self.security_account_id}).\"\n",
        "            )\n",
        "\n",
        "        if service_name == self.IDENTITY_SERVICE and target_account_id != self.identity_account_id:\n",
        "            raise PermissionError(\n",
        "                f\"VIOLATION: {service_name} requires Separation of Duties in Identity Account ({self.identity_account_id}).\"\n",
        "            )\n",
        "\n",
        "        return f\"ALLOWED: {service_name} properly delegated to {target_account_id}.\"\n",
        "\n",
        "\n",
        "class TestAWSSRAArchitecture(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRADelegationValidator(\n",
        "            mgmt_account_id=\"111111111111\",\n",
        "            security_account_id=\"222222222222\",\n",
        "            identity_account_id=\"333333333333\",\n",
        "        )\n",
        "\n",
        "    def test_management_account_isolation(self):\n",
        "        res = self.validator.validate_management_isolation(active_workloads=[])\n",
        "        self.assertTrue(res.startswith(\"ALLOWED\"))\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_management_isolation(active_workloads=[\"prod-ec2-api\"])\n",
        "\n",
        "    def test_security_tooling_delegation(self):\n",
        "        for service in [\"guardduty\", \"securityhub\", \"fms\", \"macie\", \"inspector2\"]:\n",
        "            res = self.validator.validate_delegation(service, \"222222222222\", trusted_access=True)\n",
        "            self.assertTrue(res.startswith(\"ALLOWED\"))\n",
        "\n",
        "    def test_identity_separation_of_duties(self):\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_delegation(\"iam-identity-center\", \"222222222222\", trusted_access=True)\n",
        "        res = self.validator.validate_delegation(\"iam-identity-center\", \"333333333333\", trusted_access=True)\n",
        "        self.assertTrue(res.startswith(\"ALLOWED\"))\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    suite = unittest.TestLoader().loadTestsFromTestCase(TestAWSSRAArchitecture)\n",
        "    result = unittest.TextTestRunner(verbosity=2).run(suite)\n",
        "    if result.wasSuccessful():\n",
        "        print(\"\\nALL CHECKS PASSED: Chapter 12 AWS SRA Delegation & Isolation Validated!\")"
