        "            raise ValueError(\"VISIBILITY_GAP: Critical S3/Lambda/SQS ARNs must be included in Data Events filter.\")\n",
        "        return f\"ALLOWED: Selective Data Events active for {len(filtered_critical_arns)} critical resource ARN(s).\"\n",
