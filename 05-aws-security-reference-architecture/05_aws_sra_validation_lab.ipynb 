        "class SRAMultiRegionDecisionValidator:\n",
        "    \"\"\"Evaluates the 8-question AWS SRA Multi-Region Decision Framework and 5 guidelines.\"\"\"\n",
        "\n",
        "    REQUIRED_FIVE_GUIDELINES = {\n",
        "        \"multi_region_security_design\",\n",
        "        \"deployment_order_interdependencies\",\n",
        "        \"regional_service_availability_check\",\n",
        "        \"delegated_admin_model\",\n",
        "        \"centralized_visibility_and_protection\",\n",
        "    }\n",
        "\n",
        "    def __init__(self, inputs: MultiRegionDecisionInputs) -> None:\n",
        "        self.inputs = inputs\n",
        "\n",
        "    def evaluate_multi_region_drivers(self) -> List[str]:\n",
        "        active_drivers = []\n",
        "        if self.inputs.data_sovereignty_boundary_required:\n",
        "            active_drivers.append(\"Data Sovereignty\")\n",
        "        if self.inputs.regulator_demands_geo_separated_dr:\n",
