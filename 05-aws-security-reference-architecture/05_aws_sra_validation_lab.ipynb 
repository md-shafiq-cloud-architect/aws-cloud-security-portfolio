        "\n",
        "class AWSSRAManagementSCPValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Org Management Account, SCP, and RCP Governance:\n",
        "    1. Enforces Management Account email, MFA, and quarterly (<=90 days) access reviews.\n",
        "    2. Verifies SCP/RCP scope (applies to Member Accounts only, never Management Account).\n",
        "    3. Protects Control Tower managed policies and enforces Config+Lambda fallback for non-RCP services.\n",
        "    \"\"\"\n",
        "\n",
        "    RCP_SUPPORTED_SERVICES = {\"s3\", \"sts\", \"kms\", \"sqs\", \"secretsmanager\", \"ecr\"}\n",
        "    CONTROL_TOWER_TAG = (\"aws-control-tower\", \"managed-by-control-tower\")\n",
        "\n",
        "    def __init__(self, mgmt_account_id: str):\n",
        "        self.mgmt_account_id = mgmt_account_id\n",
        "\n",
        "    def validate_mgmt_account_hygiene(\n",
        "        self, is_corporate_email: bool, mfa_enabled: bool, days_since_last_review: int\n",
        "    ) -> str:\n",
        "        if not is_corporate_email:\n",
        "            raise ValueError(\"HYGIENE_VIOLATION: Management root email must be a business-managed group address.\")\n",
        "        if not mfa_enabled:\n",
        "            raise PermissionError(\"SECURITY_VIOLATION: MFA must be enforced for all Management Account identities.\")\n",
        "        if days_since_last_review > 90:\n",
        "            raise PermissionError(\n",
        "                f\"AUDIT_VIOLATION: Quarterly access review overdue ({days_since_last_review} days > 90 days).\"\n",
        "            )\n",
        "        return \"ALLOWED: Management Account hygiene and quarterly review compliant.\"\n",
        "\n",
        "    def evaluate_policy_scope(self, target_account_id: str, policy_type: str) -> str:\n",
        "        if target_account_id == self.mgmt_account_id:\n",
        "            return f\"EXEMPT: {policy_type} does NOT restrict Management Account ({self.mgmt_account_id}).\"\n",
        "        return f\"ENFORCED: {policy_type} actively restricts Member Account ({target_account_id}).\"\n",
        "\n",
        "    def validate_control_tower_policy_lock(self, tags: dict, attempted_manual_edit: bool) -> str:\n",
        "        key, val = self.CONTROL_TOWER_TAG\n",
        "        if tags.get(key) == val and attempted_manual_edit:\n",
        "            raise PermissionError(\n",
        "                \"GUARDRAIL_LOCKED: Cannot manually alter policy tagged with aws-control-tower=managed-by-control-tower.\"\n",
        "            )\n",
        "        return \"ALLOWED: Control Tower guardrail integrity preserved.\"\n",
        "\n",
        "    def validate_service_resource_protection(\n",
        "        self, service_name: str, rcp_attached: bool, config_lambda_remediation: bool\n",
        "    ) -> str:\n",
        "        if service_name in self.RCP_SUPPORTED_SERVICES:\n",
        "            if not rcp_attached:\n",
        "                raise PermissionError(f\"GAP: Native RCP supported for '{service_name}' but not attached.\")\n",
        "            return f\"ALLOWED: '{service_name}' protected via native RCP.\"\n",
        "        else:\n",
        "            if not config_lambda_remediation:\n",
        "                raise PermissionError(\n",
        "                    f\"GAP: '{service_name}' lacks native RCP support; requires AWS Config + Lambda auto-remediation.\"\n",
        "                )\n",
        "            return f\"ALLOWED: '{service_name}' protected via AWS Config + Lambda compensating guardrail.\"\n",
        "\n",
        "\n",
        "class TestChapter20ManagementGovernance(unittest.TestCase):\n",
