        "\n",
        "    PROHIBITED_CRITICAL_ACTIONS = {\"s3:DeleteBucket\", \"kms:ScheduleKeyDeletion\", \"organizations:LeaveOrganization\"}\n",
        "\n",
        "    def check_access_not_granted(self, proposed_actions: set) -> str:\n",
        "        violations = proposed_actions.intersection(self.PROHIBITED_CRITICAL_ACTIONS)\n",
        "        if violations:\n",
        "            raise PermissionError(\n",
        "                f\"BLOCKED_BY_CheckAccessNotGranted: Prohibited critical actions found: {sorted(violations)}\"\n",
        "            )\n",
        "        return \"ALLOWED: CheckAccessNotGranted passed (zero prohibited actions).\"\n",
        "\n",
        "    def check_no_new_access(self, baseline_actions: set, updated_actions: set) -> str:\n",
        "        new_permissions = updated_actions - baseline_actions\n",
        "        if new_permissions:\n",
        "            raise PermissionError(\n",
        "                f\"BLOCKED_BY_CheckNoNewAccess: Policy grants new unapproved permissions: {sorted(new_permissions)}\"\n",
        "            )\n",
        "        return \"ALLOWED: CheckNoNewAccess passed (no privilege expansion).\"\n",
        "\n",
        "    def validate_generated_policy_readiness(\n",
        "        self, requires_pass_role: bool, pass_role_reviewed: bool, requires_s3_data_events: bool, s3_data_reviewed: bool\n",
