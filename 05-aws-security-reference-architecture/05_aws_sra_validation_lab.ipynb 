        "\n",
        "class AWSSRAIncidentResponseValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 43 (AWS Security Incident Response):\n",
        "    1. Enforces Security Tooling delegation and 5-phase IR lifecycle completeness.\n",
        "    2. Blocks unverified SSM containment runbooks from running in Production without Lab testing.\n",
        "    3. Verifies Private Subnet SSM VPC Endpoints (ssm, ssmmessages, ec2messages) for containment.\n",
        "    \"\"\"\n",
        "\n",
        "    REQUIRED_IR_PHASES = [\n",
        "        \"preparation\",\n",
        "        \"detection-and-analysis\",\n",
        "        \"triage\",\n",
        "        \"containment-and-eradication\",\n",
        "        \"post-incident-activity\",\n",
        "    ]\n",
        "\n",
        "    REQUIRED_SSM_ENDPOINTS = {\"ssm\", \"ssmmessages\", \"ec2messages\"}\n",
        "\n",
        "    def __init__(self, security_tooling_id: str):\n",
        "        self.security_tooling_id = security_tooling_id\n",
        "\n",
        "    def validate_ssm_containment_readiness(\n",
        "        self, target_env: str, runbook_tested_in_lab: bool, configured_vpc_endpoints: set\n",
        "    ) -> str:\n",
        "        if target_env == \"PROD\" and not runbook_tested_in_lab:\n",
        "            raise PermissionError(\n",
        "                \"OUTAGE_PREVENTION_BLOCK: Custom SSM response runbook MUST be tested in Lab before Production.\"\n",
        "            )\n",
        "        missing_endpoints = self.REQUIRED_SSM_ENDPOINTS - configured_vpc_endpoints\n",
        "        if missing_endpoints:\n",
        "            raise ConnectionError(\n",
        "                f\"CONTAINMENT_FAILURE_RISK: Missing required SSM VPC endpoints in private subnet: {sorted(missing_endpoints)}\"\n",
        "            )\n",
        "        return \"ALLOWED: SSM containment runbook lab-verified and private VPC endpoints ready.\"\n",
        "\n",
        "    def validate_ir_governance_and_lifecycle(\n",
        "        self, delegated_admin_id: str, configured_phases: list, ai_agent_telemetry_ready: bool\n",
        "    ) -> str:\n",
        "        if delegated_admin_id != self.security_tooling_id:\n",
        "            raise PermissionError(\n",
        "                f\"DELEGATION_ERROR: Incident Response must be delegated to Security Tooling ({self.security_tooling_id}).\"\n",
        "            )\n",
        "        if configured_phases != self.REQUIRED_IR_PHASES:\n",
        "            raise ValueError(\"LIFECYCLE_GAP: Incident Response must follow all 5 standard NIST/AWS IR phases in order.\")\n",
        "        if not ai_agent_telemetry_ready:\n",
        "            raise RuntimeError(\"INVESTIGATION_GAP: Enable CloudTrail, IAM, EC2, and Cost Explorer feeds for AI Agent.\")\n",
        "        return \"ALLOWED: Security Tooling IR delegation, 5-phase lifecycle & AI investigative telemetry verified.\"\n",
        "\n",
        "\n",
        "class TestChapter43SecurityIncidentResponse(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRAIncidentResponseValidator(security_tooling_id=\"222222222222\")\n",
        "\n",
        "    def test_ssm_runbook_lab_gate_and_vpc_endpoints(self):\n",
        "        endpoints = {\"ssm\", \"ssmmessages\", \"ec2messages\"}\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_ssm_containment_readiness(\"PROD\", runbook_tested_in_lab=True, configured_vpc_endpoints=endpoints).startswith(\"ALLOWED\")\n",
        "        )\n",
