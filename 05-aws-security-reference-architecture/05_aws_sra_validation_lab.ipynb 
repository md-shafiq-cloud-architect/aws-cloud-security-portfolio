        "class AWSSRACentralS3LogStoreValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 47 (Types of Logs & Amazon S3 as Central Log Store):\n",
        "    1. Enforces SSE-KMS (CMK), S3 Object Lock, Versioning, Block Public Access & CloudTrail Integrity Validation.\n",
        "    2. Restricts destructive policies (AWSCloudTrail_FullAccess) to a minimal set of approved principals.\n",
        "    3. Verifies continuous monitoring via AWS Config and IAM Access Analyzer.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, approved_trail_admins: set):\n",
        "        self.approved_trail_admins = approved_trail_admins\n",
        "\n",
        "    def validate_s3_log_vault_hardening(\n",
        "        self,\n",
        "        encryption_mode: str,\n",
        "        versioning_and_object_lock: bool,\n",
        "        block_public_access: bool,\n",
        "        cloudtrail_integrity_validation: bool,\n",
        "    ) -> str:\n",
        "        if encryption_mode != \"SSE-KMS-CMK\":\n",
        "            raise ValueError(\n",
        "                f\"CRYPTO_GAP: Security log buckets must use 'SSE-KMS-CMK', not '{encryption_mode}'.\"\n",
        "            )\n",
        "        if not (versioning_and_object_lock and block_public_access):\n",
        "            raise PermissionError(\n",
        "                \"VAULT_VIOLATION: Central S3 log bucket requires Versioning, Object Lock, and Block Public Access.\"\n",
        "            )\n",
        "        if not cloudtrail_integrity_validation:\n",
        "            raise PermissionError(\n",
        "                \"INTEGRITY_GAP: CloudTrail Log File Integrity Validation must be enabled.\"\n",
        "            )\n",
        "        return \"ALLOWED: Central S3 Log Store encryption, immutability, public block & integrity verified.\"\n",
        "\n",
        "    def validate_logging_principal_least_privilege(\n",
        "        self, principal_arn: str, attached_policies: set, config_and_analyzer_active: bool\n",
        "    ) -> str:\n",
        "        if \"AWSCloudTrail_FullAccess\" in attached_policies and principal_arn not in self.approved_trail_admins:\n",
        "            raise PermissionError(\n",
        "                f\"LEAST_PRIVILEGE_VIOLATION: 'AWSCloudTrail_FullAccess' denied for unapproved principal '{principal_arn}'.\"\n",
        "            )\n",
        "        if not config_and_analyzer_active:\n",
        "            raise RuntimeError(\n",
        "                \"DETECTION_GAP: Enable AWS Config and IAM Access Analyzer to monitor log bucket access.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Logging IAM permissions and continuous monitoring verified for '{principal_arn}'.\"\n",
        "\n",
        "\n",
