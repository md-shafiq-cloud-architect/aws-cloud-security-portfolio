        "        if not stored_in_secrets_manager:\n",
        "            raise PermissionError(\"VIOLATION: Hardcoded or unmanaged credential detected. Use Secrets Manager.\")\n",
        "        if not auto_rotation:\n",
        "            raise ValueError(\"COMPLIANCE_GAP: Secrets Manager secret must have automatic rotation enabled.\")\n",
        "        return \"ALLOWED: Secret securely managed with automated rotation.\"\n",
