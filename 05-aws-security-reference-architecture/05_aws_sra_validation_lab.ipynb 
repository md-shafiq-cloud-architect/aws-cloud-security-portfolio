        "class AWSSRACloudWatchAndLogArchiveValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 34 (Amazon CloudWatch & Log Archive Account):\n",
        "    1. Blocks analytics/monitoring workloads inside Log Archive Account (must run in Security Tooling).\n",
        "    2. Enforces S3 Object Lock (COMPLIANCE mode / WORM) and Glacier Lifecycle tiering in Log Archive.\n",
        "    3. Verifies CloudWatch Pipelines OCSF normalization across AWS and third-party sources.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, security_tooling_id: str, log_archive_id: str):\n",
        "        self.security_tooling_id = security_tooling_id\n",
        "        self.log_archive_id = log_archive_id\n",
        "\n",
        "    def validate_analytics_workload_placement(self, target_account_id: str, workload_type: str) -> str:\n",
        "        if target_account_id == self.log_archive_id and workload_type in {\"cloudwatch-analytics\", \"athena-query\", \"omni-space\"}:\n",
        "            raise PermissionError(\n",
        "                \"ARCHITECTURE_VIOLATION: Log Archive Account MUST NOT run analytics workloads. \"\n",
        "                f\"Deploy '{workload_type}' in Security Tooling Account ({self.security_tooling_id}).\"\n",
        "            )\n",
        "        if target_account_id != self.security_tooling_id:\n",
        "            raise PermissionError(\"DELEGATION_ERROR: Centralized observability must run in Security Tooling Account.\")\n",
        "        return f\"ALLOWED: '{workload_type}' properly isolated in Security Tooling Account.\"\n",
        "\n",
        "    def validate_log_archive_bucket_controls(\n",
        "        self, object_lock_mode: str, retention_years: int, glacier_lifecycle_enabled: bool\n",
        "    ) -> str:\n",
        "        if object_lock_mode != \"COMPLIANCE\":\n",
        "            raise PermissionError(\n",
        "                \"IMMUTABILITY_VIOLATION: Log Archive S3 bucket requires S3 Object Lock in COMPLIANCE mode (WORM).\"\n",
        "            )\n",
