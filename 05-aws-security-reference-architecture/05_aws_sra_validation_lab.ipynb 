        "            \"preparation\",\n",
        "            \"detection-and-analysis\",\n",
        "            \"triage\",\n",
        "            \"containment-and-eradication\",\n",
        "            \"post-incident-activity\",\n",
        "        ]\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_ir_governance_and_lifecycle(\"222222222222\", phases, True).startswith(\"ALLOWED\")\n",
