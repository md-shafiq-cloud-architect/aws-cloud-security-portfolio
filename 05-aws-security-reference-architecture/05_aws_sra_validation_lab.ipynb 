        "class AdvancedOrgPolicyEvaluator:\n",
        "    \"\"\"Validates Hybrid SCPs (Allow-List Intersection + Deny-List) and RCP Resource Boundaries.\"\"\"\n",
        "\n",
        "    def evaluate_scp_allow_list_hierarchy(\n",
        "        self,\n",
        "        root_allowed: set,\n",
        "        ou_allowed: set,\n",
        "        account_allowed: set,\n",
        "        requested_service: str,\n",
        "    ) -> bool:\n",
        "        \"\"\"In AWS SCP Allow-List mode, a service must be explicitly allowed at EVERY level (Root ∩ OU ∩ Account).\"\"\"\n",
        "        effective_allowed = root_allowed & ou_allowed & account_allowed\n",
        "        return requested_service in effective_allowed\n",
        "\n",
        "    def evaluate_rcp_resource_access(\n",
        "        self,\n",
        "        rcp_enabled: bool,\n",
        "        custom_rcp_denied_resources: set,\n",
        "        target_resource: str,\n",
        "        iam_allowed: bool,\n",
        "    ) -> str:\n",
        "        \"\"\"Simulates AWS Resource Control Policies (RCPFullAWSAccess + Custom RCP Deny).\"\"\"\n",
        "        if not iam_allowed:\n",
        "            return \"DENIED_BY_IAM_IMPLICIT_DENY\"\n",
        "        # Default RCPFullAWSAccess does not grant extra permissions; custom RCPs enforce explicit deny\n",
        "        if rcp_enabled and target_resource in custom_rcp_denied_resources:\n",
        "            return f\"DENIED_BY_RCP ({target_resource} blocked at Org boundary)\"\n",
        "        return f\"ALLOWED_RESOURCE_ACCESS ({target_resource})\"\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    evaluator = AdvancedOrgPolicyEvaluator()\n",
        "\n",
        "    # 1. Test SCP Allow-List Intersection (Must exist at Root, OU, AND Account)\n",
        "    root_services = {\"s3\", \"ec2\", \"kms\", \"bedrock\"}\n",
        "    ou_services = {\"s3\", \"ec2\", \"kms\"}  # 'bedrock' omitted at OU level\n",
        "    acc_services = {\"s3\", \"ec2\", \"kms\", \"bedrock\"}\n",
        "\n",
        "    assert (\n",
        "        evaluator.evaluate_scp_allow_list_hierarchy(\n",
        "            root_services, ou_services, acc_services, \"s3\"\n",
        "        )\n",
        "        is True\n",
        "    )\n",
        "    assert (\n",
        "        evaluator.evaluate_scp_allow_list_hierarchy(\n",
        "            root_services, ou_services, acc_services, \"bedrock\"\n",
        "        )\n",
        "        is False\n",
        "    ), \"Intersection rule failed!\"\n",
        "\n",
        "    # 2. Test Resource Control Policy (RCP) Enforcement\n",
        "    denied_buckets = {\"arn:aws:s3:::corp-crown-jewels-vault\"}\n",
        "    res_blocked = evaluator.evaluate_rcp_resource_access(\n",
        "        rcp_enabled=True,\n",
        "        custom_rcp_denied_resources=denied_buckets,\n",
        "        target_resource=\"arn:aws:s3:::corp-crown-jewels-vault\",\n",
        "        iam_allowed=True,\n",
        "    )\n",
        "    assert \"DENIED_BY_RCP\" in res_blocked\n",
        "\n",
        "    res_ok = evaluator.evaluate_rcp_resource_access(\n",
        "        rcp_enabled=True,\n",
        "        custom_rcp_denied_resources=denied_buckets,\n",
        "        target_resource=\"arn:aws:s3:::app-public-assets\",\n",
        "        iam_allowed=True,\n",
        "    )\n",
        "    assert res_ok.startswith(\"ALLOWED\")\n",
        "\n",
        "    print(\n",
        "        \"ALL CHECKS PASSED: Chapter 11 Hybrid SCP Allow-List & RCP Boundaries\"\n",
        "        \" Validated!\"\n",
        "    )"
