        "import unittest\n",
        "\n",
        "class AWSSRARegionGovernanceValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Multi-Region Governance:\n",
        "    1. Enforces SCP Region-Deny for unauthorized regions while exempting Global Services.\n",
        "    2. Verifies Security Hub Cross-Region Aggregation to a single Home Region.\n",
        "    3. Ensures IaC orchestration (CfCT / AFT) is enabled at enterprise scale (>50 accounts).\n",
        "    \"\"\"\n",
        "\n",
        "    GLOBAL_EXEMPT_SERVICES = {\"iam\", \"organizations\", \"sts\", \"cloudfront\", \"route53\", \"waf\"}\n",
        "\n",
        "    def __init__(self, approved_regions: set, home_aggregation_region: str):\n",
        "        if home_aggregation_region not in approved_regions:\n",
        "            raise ValueError(\"CONFIG_ERROR: Home aggregation region must be in approved_regions.\")\n",
        "        self.approved_regions = approved_regions\n",
        "        self.home_aggregation_region = home_aggregation_region\n",
        "\n",
        "    def evaluate_scp_region_request(self, service: str, requested_region: str) -> str:\n",
        "        if service in self.GLOBAL_EXEMPT_SERVICES:\n",
        "            return f\"ALLOWED: Global service '{service}' is exempt from regional SCP deny.\"\n",
        "        if requested_region not in self.approved_regions:\n",
        "            raise PermissionError(\n",
        "                f\"DENIED_BY_SCP: Region '{requested_region}' is locked down for service '{service}'.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Service '{service}' permitted in approved region '{requested_region}'.\"\n",
        "\n",
        "    def validate_security_hub_aggregation(self, linked_regions: set, target_home_region: str) -> str:\n",
        "        if target_home_region != self.home_aggregation_region:\n",
        "            raise PermissionError(\n",
        "                f\"VIOLATION: Findings routed to '{target_home_region}' instead of '{self.home_aggregation_region}'.\"\n",
        "            )\n",
        "        missing_regions = self.approved_regions - linked_regions - {self.home_aggregation_region}\n",
        "        if missing_regions:\n",
        "            raise ValueError(f\"BLIND_SPOT: Active regions missing from Security Hub aggregation: {missing_regions}\")\n",
        "        return f\"ALLOWED: All active regions aggregated into Home Region '{self.home_aggregation_region}'.\"\n",
        "\n",
        "    def validate_scale_orchestration(self, account_count: int, automation_tool: str) -> str:\n",
        "        valid_tools = {\"CfCT\", \"AFT\"}\n",
