        "class AWSSRADefenseInDepthValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA 6-Layer Structural Security Model (Defense-in-Depth):\n",
        "    Layer 1: AWS Organization\n",
        "    Layer 2: Organizational Unit (OU)\n",
        "    Layer 3: AWS Account\n",
        "    Layer 4: Network & Content Delivery\n",
        "    Layer 5: AWS Principals\n",
        "    Layer 6: AWS Resources\n",
        "    \"\"\"\n",
        "\n",
        "    VALID_LAYERS = {\n",
        "        \"organization\",\n",
        "        \"ou\",\n",
        "        \"account\",\n",
        "        \"network\",\n",
        "        \"principals\",\n",
        "        \"resources\",\n",
        "    }\n",
        "\n",
        "    SERVICE_LAYER_MAP = {\n",
        "        \"firewall-manager\": \"organization\",\n",
        "        \"root-scp\": \"organization\",\n",
        "        \"ou-scp\": \"ou\",\n",
        "        \"account-s3-public-block\": \"account\",\n",
        "        \"network-firewall\": \"network\",\n",
        "        \"private-ca\": \"network\",\n",
        "        \"iam-identity-center\": \"principals\",\n",
        "        \"guardduty\": \"principals\",\n",
        "        \"kms-encryption\": \"resources\",\n",
        "        \"resource-policy\": \"resources\",\n",
        "    }\n",
        "\n",
        "    def validate_control_placement(self, control_name: str, assigned_layer: str) -> str:\n",
        "        expected_layer = self.SERVICE_LAYER_MAP.get(control_name)\n",
        "        if not expected_layer:\n",
        "            raise ValueError(f\"UNKNOWN_CONTROL: '{control_name}' is not mapped in SRA baseline.\")\n",
        "        if assigned_layer != expected_layer:\n",
        "            raise PermissionError(\n",
        "                f\"MISPLACED_CONTROL: '{control_name}' belongs to '{expected_layer}' layer, not '{assigned_layer}'.\"\n",
        "            )\n",
        "        return f\"ALLOWED: '{control_name}' properly placed in '{assigned_layer}' layer.\"\n",
        "\n",
        "    def audit_workload_defense_in_depth(self, workload_name: str, active_controls_by_layer: dict) -> str:\n",
        "        missing_layers = self.VALID_LAYERS - set(active_controls_by_layer.keys())\n",
        "        if missing_layers:\n",
        "            raise AssertionError(\n",
        "                f\"DEFENSE_GAP for '{workload_name}': Missing security controls in layers: {sorted(missing_layers)}\"\n",
        "            )\n",
        "        for layer, controls in active_controls_by_layer.items():\n",
        "            if not controls:\n",
        "                raise AssertionError(f\"EMPTY_LAYER for '{workload_name}': Layer '{layer}' has zero active controls.\")\n",
        "        return f\"ALLOWED: '{workload_name}' achieves full 6-layer Defense-in-Depth.\"\n",
        "\n",
        "\n",
        "class TestChapter15DefenseInDepth(unittest.TestCase):\n",
