        "\n",
        "class AWSSRASecurityToolingValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 26 (Security OU - Security Tooling Account):\n",
        "    1. Enforces Read-Only default credentials and audited/approved Write elevation.\n",
        "    2. Verifies automated EventBridge + Lambda remediation readiness.\n",
        "    3. Validates multi-tooling Separation of Duties and Control Tower Security OU constraints.\n",
        "    \"\"\"\n",
        "\n",
        "    def validate_analyst_access(\n",
        "        self, access_mode: str, change_ticket_approved: bool, session_monitored: bool\n",
        "    ) -> str:\n",
        "        if not session_monitored:\n",
        "            raise PermissionError(\"AUDIT_VIOLATION: All Security Tooling account sessions must be monitored.\")\n",
        "        if access_mode == \"READ_ONLY\":\n",
        "            return \"ALLOWED: Analyst operating with default least-privilege Read-Only/Audit role.\"\n",
        "        if access_mode == \"WRITE_ELEVATED\":\n",
        "            if not change_ticket_approved:\n",
        "                raise PermissionError(\n",
        "                    \"PRIVILEGE_VIOLATION: Write/Modify access in Security Tooling requires approved change ticket.\"\n",
        "                )\n",
        "            return \"ALLOWED: Time-bound Write elevation verified with approved change ticket.\"\n",
        "        raise ValueError(f\"INVALID_MODE: Unknown access mode '{access_mode}'.\")\n",
        "\n",
        "    def validate_multi_tooling_ou_placement(\n",
        "        self, is_control_tower_managed: bool, target_ou: str, is_extra_tooling_account: bool\n",
        "    ) -> str:\n",
        "        if is_control_tower_managed and is_extra_tooling_account and target_ou == \"Core-Security-OU\":\n",
        "            raise ValueError(\n",
        "                \"CONTROL_TOWER_CONSTRAINT: Do not place extra custom tooling accounts inside Control Tower's \"\n",
        "                \"Core Security OU. Place secondary tooling accounts in a dedicated Custom-Security-OU.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Security Tooling account cleanly placed in '{target_ou}'.\"\n",
        "\n",
        "    def validate_automated_remediation_pipeline(\n",
        "        self, security_lake_active: bool, eventbridge_lambda_active: bool\n",
        "    ) -> str:\n",
        "        if not (security_lake_active and eventbridge_lambda_active):\n",
        "            raise RuntimeError(\n",
        "                \"SECOPS_GAP: Security Tooling requires Amazon Security Lake and EventBridge+Lambda auto-remediation.\"\n",
        "            )\n",
        "        return \"ALLOWED: Centralized telemetry (Security Lake) and EventBridge+Lambda auto-response active.\"\n",
        "\n",
        "\n",
        "class TestChapter26SecurityTooling(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRASecurityToolingValidator()\n",
        "\n",
        "    def test_analyst_read_only_and_write_elevation(self):\n",
