        "\n",
        "class AWSSRALogArchiveAccountValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 46 (Security OU - Log Archive Account):\n",
        "    1. Enforces strict log immutability and blocks direct human access (automated mechanisms only).\n",
        "    2. Verifies layered preventive (KMS) and detective (AWS Config policy-drift) controls + durability replication.\n",
        "    3. Enforces principal access boundaries for consolidated operational vs security logs.\n",
        "    \"\"\"\n",
        "\n",
        "    def validate_immutability_and_human_lockout(\n",
        "        self, is_immutable_worm: bool, requester_type: str, is_monitored_automation: bool\n",
        "    ) -> str:\n",
        "        if not is_immutable_worm:\n",
        "            raise PermissionError(\"IMMUTABILITY_VIOLATION: Central log storage MUST be immutable (WORM).\")\n",
        "        if requester_type == \"HUMAN_DIRECT\":\n",
        "            raise PermissionError(\n",
        "                \"ACCESS_VIOLATION: Direct human access to Log Archive S3 bucket is strictly prohibited.\"\n",
        "            )\n",
        "        if requester_type == \"AUTOMATED_SERVICE\" and not is_monitored_automation:\n",
        "            raise PermissionError(\"AUDIT_VIOLATION: Automated log access mechanism must be strictly monitored.\")\n",
        "        return \"ALLOWED: Immutable log vault and monitored automated-only access verified.\"\n",
        "\n",
        "    def validate_layered_controls_and_durability(\n",
        "        self, kms_encrypted: bool, aws_config_policy_drift_active: bool, cross_region_replication: bool\n",
        "    ) -> str:\n",
        "        if not kms_encrypted:\n",
        "            raise ValueError(\"PREVENTIVE_GAP: Central logs must be encrypted with a controlled KMS key.\")\n",
        "        if not aws_config_policy_drift_active:\n",
        "            raise RuntimeError(\n",
        "                \"DETECTIVE_GAP: AWS Config must monitor bucket/KMS policies for unexpected changes.\"\n",
        "            )\n",
        "        if not cross_region_replication:\n",
        "            raise RuntimeError(\"DURABILITY_GAP: Enable automated replication/archival for log durability.\")\n",
        "        return \"ALLOWED: Layered preventive (KMS), detective (AWS Config) & durability replication verified.\"\n",
        "\n",
        "    def validate_operational_log_boundary(\n",
        "        self, principal_arn: str, approved_ops_readers: set\n",
        "    ) -> str:\n",
        "        if principal_arn not in approved_ops_readers:\n",
        "            raise PermissionError(\n",
        "                f\"BOUNDARY_VIOLATION: Principal '{principal_arn}' is outside the defined operational log read boundary.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Principal '{principal_arn}' authorized within operational log access boundary.\"\n",
        "\n",
        "\n",
        "class TestChapter46LogArchiveAccount(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRALogArchiveAccountValidator()\n",
        "\n",
        "    def test_blocks_human_access_and_requires_worm(self):\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_immutability_and_human_lockout(True, \"AUTOMATED_SERVICE\", True).startswith(\"ALLOWED\")\n",
        "        )\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_immutability_and_human_lockout(True, \"HUMAN_DIRECT\", False)\n",
        "\n",
        "    def test_preventive_kms_detective_config_and_replication(self):\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_layered_controls_and_durability(True, True, True).startswith(\"ALLOWED\")\n",
        "        )\n",
        "        with self.assertRaises(RuntimeError):\n",
