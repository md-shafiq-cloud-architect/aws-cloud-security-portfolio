        "        missing = self.REQUIRED_BACKEND_SERVICES - integrated_services\n",
        "        if missing:\n",
        "            raise RuntimeError(\n",
        "                f\"LANDING_ZONE_INCOMPLETE: Missing core Control Tower backend services: {sorted(missing)}\"\n",
        "            )\n",
        "        return \"ALLOWED: All 4 core Control Tower orchestration services verified.\"\n",
        "\n",
        "    def validate_account_factory_lifecycle(\n",
        "        self, customization_engine: str, lifecycle_hook_completed: bool, scp_active: bool, config_active: bool\n",
        "    ) -> str:\n",
        "        if customization_engine not in self.SUPPORTED_CUSTOMIZATION_ENGINES:\n",
        "            raise ValueError(\n",
        "                f\"CUSTOMIZATION_GAP: Engine '{customization_engine}' invalid. Must use CfCT or AFT.\"\n",
        "            )\n",
        "        if not lifecycle_hook_completed:\n",
        "            raise PermissionError(\n",
        "                \"PROVISIONING_GATE_BLOCKED: Account Factory lifecycle baseline automation still running.\"\n",
        "            )\n",
        "        if not (scp_active and config_active):\n",
        "            raise PermissionError(\n",
        "                \"GUARDRAIL_GAP: Both Preventive (SCP) and Detective (AWS Config) controls must be active.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Account provisioned cleanly via {customization_engine} with full guardrails.\"\n",
        "\n",
        "\n",
        "class TestChapter24ControlTower(unittest.TestCase):\n",
