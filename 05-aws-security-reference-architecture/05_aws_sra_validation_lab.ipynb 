        "        self.log_archive_id = log_archive_id\n",
        "\n",
        "    def validate_assume_root_call(self, caller_account_id: str, task_policy_name: str) -> str:\n",
        "        if caller_account_id != self.security_tooling_id:\n",
        "            raise PermissionError(\n",
        "                f\"DELEGATION_VIOLATION: sts:AssumeRoot denied for unauthorized account '{caller_account_id}'.\"\n",
        "            )\n",
        "        if task_policy_name not in self.APPROVED_ASSUME_ROOT_TASKS:\n",
        "            raise PermissionError(\n",
        "                f\"SCOPE_VIOLATION: Task policy '{task_policy_name}' is not an approved surgical root task.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Surgical sts:AssumeRoot verified with task policy '{task_policy_name}'.\"\n",
        "\n",
        "    def validate_organization_trail(\n",
        "        self,\n",
        "        is_org_trail: bool,\n",
        "        destination_account_id: str,\n",
