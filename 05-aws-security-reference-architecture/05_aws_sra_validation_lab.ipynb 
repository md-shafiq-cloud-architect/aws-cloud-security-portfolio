        "        invalid_actions = {a.upper() for a in self.config.web_acl_actions} - self.VALID_WAF_ACTIONS\n",
        "        if invalid_actions:\n",
        "            raise ValueError(f\"Invalid AWS WAF Web ACL actions: {sorted(invalid_actions)}\")\n",
        "\n",
        "        if self.config.shield_tier.lower() == \"advanced\" and not self.config.srt_proactive_engagement_enabled:\n",
        "            raise ValueError(\n",
        "                \"SRA Violation: Shield Advanced SHOULD enable SRT Proactive Engagement \"\n",
        "                \"with CloudWatch high-priority alarms.\"\n",
        "            )\n",
