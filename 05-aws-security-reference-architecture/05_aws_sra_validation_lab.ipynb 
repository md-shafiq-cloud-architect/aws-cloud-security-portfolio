        "import unittest\n",
        "\n",
        "class AWSSRAPrincipalResourceValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Principals & Resources Layer:\n",
        "    1. Enforces Zero Root User Access Keys and documented Break-Glass approval.\n",
        "    2. Simulates AWS IAM Policy Evaluation (Explicit Deny > Cross-Account AND > Same-Account OR).\n",
        "    3. Detects unintended external resource exposure (IAM Access Analyzer logic).\n",
        "    \"\"\"\n",
        "\n",
        "    def validate_root_hygiene(self, root_access_keys_count: int, root_login_approved: bool) -> str:\n",
        "        if root_access_keys_count > 0:\n",
        "            raise PermissionError(\n",
        "                f\"CRITICAL_VIOLATION: {root_access_keys_count} Root user access key(s) detected. MUST NOT exist!\"\n",
        "            )\n",
        "        if not root_login_approved:\n",
        "            raise PermissionError(\"AUDIT_VIOLATION: Root action attempted without documented approval ticket.\")\n",
        "        return \"ALLOWED: Root user hygiene and break-glass governance verified.\"\n",
        "\n",
        "    def evaluate_resource_access(\n",
        "        self,\n",
        "        principal_account: str,\n",
        "        resource_account: str,\n",
        "        identity_allow: bool,\n",
        "        resource_allow: bool,\n",
        "        explicit_deny: bool = False,\n",
        "    ) -> str:\n",
        "        if explicit_deny:\n",
        "            raise PermissionError(\"DENIED: Explicit Deny overrides all Allow statements.\")\n",
        "\n",
        "        is_cross_account = principal_account != resource_account\n",
        "        if is_cross_account:\n",
        "            if identity_allow and resource_allow:\n",
        "                return \"ALLOWED: Cross-account access verified (Both Identity & Resource policies allow).\"\n",
        "            raise PermissionError(\n",
        "                \"DENIED: Cross-account access requires BOTH Identity-based and Resource-based Allow.\"\n",
        "            )\n",
        "        else:\n",
        "            if identity_allow or resource_allow:\n",
        "                return \"ALLOWED: Same-account access verified (Identity OR Resource policy allows).\"\n",
        "            raise PermissionError(\"DENIED: Implicit deny (neither Identity nor Resource policy allows).\")\n",
        "\n",
        "    def check_external_exposure(self, resource_principal: str, trusted_org_accounts: set) -> str:\n",
        "        if resource_principal == \"*\" or resource_principal not in trusted_org_accounts:\n",
        "            raise PermissionError(\n",
        "                f\"EXPOSURE_ALERT: IAM Access Analyzer detected external principal '{resource_principal}'.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Resource access restricted to trusted account '{resource_principal}'.\"\n",
        "\n",
        "\n",
        "class TestChapter19PrincipalsResources(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRAPrincipalResourceValidator()\n",
        "        self.trusted_accounts = {\"111111111111\", \"222222222222\"}\n",
        "\n",
        "    def test_root_user_lockdown(self):\n",
        "        self.assertTrue(self.validator.validate_root_hygiene(0, True).startswith(\"ALLOWED\"))\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_root_hygiene(1, True)\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_root_hygiene(0, False)\n",
        "\n",
        "    def test_same_vs_cross_account_policy_logic(self):\n",
        "        # Same-account works with only Identity-based Allow\n",
        "        res_same = self.validator.evaluate_resource_access(\"111111111111\", \"111111111111\", True, False)\n",
        "        self.assertTrue(res_same.startswith(\"ALLOWED\"))\n",
        "        # Cross-account fails if Resource-based Allow is missing\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.evaluate_resource_access(\"111111111111\", \"222222222222\", True, False)\n",
        "        # Cross-account succeeds when BOTH allow\n",
        "        res_cross = self.validator.evaluate_resource_access(\"111111111111\", \"222222222222\", True, True)\n",
        "        self.assertTrue(res_cross.startswith(\"ALLOWED\"))\n",
        "\n",
        "    def test_access_analyzer_external_exposure(self):\n",
        "        self.assertTrue(self.validator.check_external_exposure(\"222222222222\", self.trusted_accounts).startswith(\"ALLOWED\"))\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.check_external_exposure(\"*\", self.trusted_accounts)\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    suite = unittest.TestLoader().loadTestsFromTestCase(TestChapter19PrincipalsResources)\n",
