        "\n",
        "class AWSSRAOperationsGovernanceValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 23 Controls:\n",
        "    1. IAM Access Advisor (Last Accessed Data) pruning for permissions unused >= 180 days.\n",
        "    2. Systems Manager Quick Setup enforcing biweekly (<= 14 days) SSM Agent updates.\n",
        "    3. Systems Manager Explorer multi-account & multi-region OpsItems aggregation.\n",
        "    \"\"\"\n",
        "\n",
        "    MAX_UNUSED_DAYS = 180\n",
        "    MAX_AGENT_UPDATE_DAYS = 14\n",
        "\n",
        "    def audit_service_last_accessed(self, role_name: str, service_usage_days: dict) -> list:\n",
        "        stale_services = [\n",
        "            svc for svc, days_unused in service_usage_days.items() if days_unused >= self.MAX_UNUSED_DAYS\n",
        "        ]\n",
        "        if stale_services:\n",
        "            return stale_services\n",
        "        return []\n",
        "\n",
        "    def validate_ssm_quick_setup(self, agent_update_interval_days: int, host_management_enabled: bool) -> str:\n",
        "        if not host_management_enabled:\n",
        "            raise PermissionError(\"CONFIG_GAP: SSM Quick Setup Host Management must be enabled.\")\n",
        "        if agent_update_interval_days > self.MAX_AGENT_UPDATE_DAYS:\n",
        "            raise ValueError(\n",
        "                f\"PATCH_RISK: SSM Agent update interval ({agent_update_interval_days}d) exceeds biweekly (14d) policy.\"\n",
        "            )\n",
        "        return \"ALLOWED: SSM Quick Setup biweekly agent update and host management verified.\"\n",
        "\n",
        "    def validate_ssm_explorer_aggregation(self, org_sync_enabled: bool, ops_data_sources_enabled: bool) -> str:\n",
        "        if not (org_sync_enabled and ops_data_sources_enabled):\n",
        "            raise RuntimeError(\"VISIBILITY_GAP: Systems Manager Explorer must aggregate multi-account OpsItems.\")\n",
        "        return \"ALLOWED: Systems Manager Explorer multi-account operational dashboard active.\"\n",
        "\n",
