        "        if req.uri_path.startswith(\"/api/v2/payments\") and req.headers.get(\"x-tenant-tier\") == \"enterprise\":\n",
        "            return \"arn:aws:vpc-lattice:us-east-1:111122223333:targetgroup/tg-eks-payments-v2\"\n",
