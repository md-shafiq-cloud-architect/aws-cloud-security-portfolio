        "\n",
        "    VALID_EVIDENCE_TYPES = {\"config-securityhub\", \"cloudtrail-events\", \"aws-api-snapshots\", \"manual-upload\"}\n",
        "\n",
        "    def __init__(self, security_tooling_id: str, log_archive_id: str):\n",
        "        self.security_tooling_id = security_tooling_id\n",
        "        self.log_archive_id = log_archive_id\n",
        "\n",
        "    def validate_co_located_delegated_admin(\n",
        "        self, audit_manager_admin: str, security_hub_admin: str\n",
        "    ) -> str:\n",
        "        if not (audit_manager_admin == security_hub_admin == self.security_tooling_id):\n",
        "            raise PermissionError(\n",
        "                \"INGESTION_FAILURE_RISK: Audit Manager and Security Hub Delegated Admin MUST be the exact same \"\n",
        "                f\"Security Tooling Account ({self.security_tooling_id}).\"\n",
        "            )\n",
        "        return \"ALLOWED: Audit Manager & Security Hub co-located in Security Tooling Account.\"\n",
        "\n",
        "    def validate_report_publishing_and_kms(\n",
        "        self, kms_cmk_enabled: bool, target_s3_account: str, bucket_policy_restricted_to_service: bool\n",
        "    ) -> str:\n",
        "        if not kms_cmk_enabled:\n",
        "            raise ValueError(\"CRYPTO_GAP: Audit Manager requires a dedicated KMS Customer Managed Key (CMK).\")\n",
        "        if target_s3_account != self.log_archive_id or not bucket_policy_restricted_to_service:\n",
        "            raise PermissionError(\n",
