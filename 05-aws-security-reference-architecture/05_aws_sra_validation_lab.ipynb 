        "import unittest\n",
        "\n",
        "class AWSSRAInspectorValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 42 (Amazon Inspector & Code Security):\n",
        "    1. Enforces continuous scanning across EC2 (with SSM Agent), ECR, and Lambda.\n",
        "    2. Validates Shift-Left Code Security (SAST, SCA, IaC) PR gating and public endpoint access.\n",
        "    3. Ensures Security Hub CSPM integration and KMS-CMK encrypted S3 archival via EventBridge.\n",
        "    \"\"\"\n",
        "\n",
        "    REQUIRED_SCAN_TARGETS = {\"ec2\", \"ecr\", \"lambda\", \"network-reachability\"}\n",
        "    REQUIRED_CODE_SCANNERS = {\"SAST\", \"SCA\", \"IaC\"}\n",
        "\n",
        "    def validate_continuous_workload_scanning(\n",
        "        self, enabled_targets: set, ssm_agent_active_on_ec2: bool\n",
        "    ) -> str:\n",
        "        missing = self.REQUIRED_SCAN_TARGETS - enabled_targets\n",
        "        if missing:\n",
        "            raise RuntimeError(f\"SCAN_GAP: Missing Inspector scan targets: {sorted(missing)}\")\n",
        "        if not ssm_agent_active_on_ec2:\n",
        "            raise PermissionError(\n",
        "                \"AGENT_PREREQUISITE: Amazon EC2 continuous package scanning requires active AWS Systems Manager (SSM) Agent.\"\n",
        "            )\n",
        "        return \"ALLOWED: Continuous Inspector scanning verified across EC2 (SSM), ECR, Lambda & Network.\"\n",
        "\n",
        "    def validate_code_security_shift_left(\n",
        "        self, active_scanners: set, public_repo_connectivity: bool, critical_unpatched_cves: int\n",
        "    ) -> str:\n",
        "        if not self.REQUIRED_CODE_SCANNERS.issubset(active_scanners):\n",
        "            raise ValueError(\"APPSEC_GAP: Inspector Code Security must enforce SAST, SCA, and IaC scanning.\")\n",
        "        if not public_repo_connectivity:\n",
        "            raise ConnectionError(\n",
        "                \"CONNECTIVITY_ERROR: Public internet access is required to integrate external GitHub/SCM repositories.\"\n",
        "            )\n",
        "        if critical_unpatched_cves > 0:\n",
        "            raise PermissionError(\n",
        "                f\"PR_GATE_BLOCKED: {critical_unpatched_cves} critical vulnerability(s) detected in Pull Request.\"\n",
        "            )\n",
        "        return \"ALLOWED: Shift-Left Inspector Code Security (SAST/SCA/IaC) passed.\"\n",
        "\n",
        "    def validate_telemetry_and_kms_archive(\n",
        "        self, security_hub_integrated: bool, eventbridge_s3_kms_cmk: bool\n",
        "    ) -> str:\n",
        "        if not security_hub_integrated:\n",
        "            raise RuntimeError(\"POSTURE_GAP: Inspector findings should integrate with AWS Security Hub CSPM.\")\n",
        "        if not eventbridge_s3_kms_cmk:\n",
        "            raise PermissionError(\n",
        "                \"ARCHIVAL_VIOLATION: Export findings via EventBridge to a KMS-CMK encrypted central S3 bucket.\"\n",
        "            )\n",
        "        return \"ALLOWED: Security Hub integration and KMS-CMK encrypted findings archival verified.\"\n",
        "\n",
        "\n",
        "class TestChapter42AmazonInspector(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRAInspectorValidator()\n",
        "\n",
