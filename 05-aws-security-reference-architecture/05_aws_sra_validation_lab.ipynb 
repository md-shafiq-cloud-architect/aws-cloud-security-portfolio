        "import unittest\n",
        "\n",
        "class AWSSRALandingZoneValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA 6-Account Structure, OU Placement, Immutable Logging,\n",
        "    and Service-Boundary Account Naming (avoiding Org-Chart coupling).\n",
        "    \"\"\"\n",
        "\n",
        "    VALID_OU_MAPPING = {\n",
        "        \"management\": \"ROOT\",\n",
        "        \"security-tooling\": \"Security-OU\",\n",
        "        \"log-archive\": \"Security-OU\",\n",
        "        \"network\": \"Infrastructure-OU\",\n",
        "        \"shared-services\": \"Infrastructure-OU\",\n",
        "        \"application\": \"Workloads-OU\",\n",
        "    }\n",
        "\n",
        "    FORBIDDEN_ORG_CHART_NAMES = {\"hr-team\", \"finance-dept\", \"marketing-group\", \"bob-team\"}\n",
        "\n",
        "    def validate_ou_placement(self, account_role: str, assigned_ou: str) -> str:\n",
        "        expected_ou = self.VALID_OU_MAPPING.get(account_role)\n",
        "        if not expected_ou:\n",
        "            raise ValueError(f\"UNKNOWN_ROLE: {account_role} is not a valid SRA account role.\")\n",
        "        if assigned_ou != expected_ou:\n",
        "            raise PermissionError(\n",
        "                f\"VIOLATION: {account_role} must be placed in {expected_ou}, found in {assigned_ou}.\"\n",
        "            )\n",
        "        return f\"ALLOWED: {account_role} correctly placed in {assigned_ou}.\"\n",
        "\n",
        "    def validate_log_archive_immutability(self, object_lock_enabled: bool, lock_mode: str) -> str:\n",
        "        if not object_lock_enabled or lock_mode != \"COMPLIANCE\":\n",
        "            raise PermissionError(\n",
        "                \"VIOLATION: Log Archive Account requires S3 Object Lock in COMPLIANCE mode.\"\n",
        "            )\n",
        "        return \"ALLOWED: Log Archive is strictly immutable (COMPLIANCE mode).\"\n",
        "\n",
        "    def validate_workload_account_boundary(self, account_name: str) -> str:\n",
        "        lower_name = account_name.lower()\n",
        "        for forbidden in self.FORBIDDEN_ORG_CHART_NAMES:\n",
        "            if forbidden in lower_name:\n",
        "                raise ValueError(\n",
        "                    f\"DESIGN_FLAW: Account '{account_name}' is coupled to an org-chart team ({forbidden}). \"\n",
        "                    \"Use software service boundaries instead (e.g., payments-api-prod).\"\n",
        "                )\n",
        "        if not any(lower_name.endswith(env) for env in (\"-dev\", \"-staging\", \"-prod\")):\n",
        "            raise ValueError(\n",
        "                f\"DESIGN_FLAW: Account '{account_name}' must specify environment isolation (-dev, -staging, -prod).\"\n",
        "            )\n",
        "        return f\"ALLOWED: '{account_name}' follows strict service and environment isolation.\"\n",
        "\n",
        "\n",
        "class TestChapter13SRAStructure(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRALandingZoneValidator()\n",
        "\n",
        "    def test_ou_placements(self):\n",
        "        self.assertTrue(self.validator.validate_ou_placement(\"management\", \"ROOT\").startswith(\"ALLOWED\"))\n",
        "        self.assertTrue(self.validator.validate_ou_placement(\"log-archive\", \"Security-OU\").startswith(\"ALLOWED\"))\n",
        "        self.assertTrue(self.validator.validate_ou_placement(\"network\", \"Infrastructure-OU\").startswith(\"ALLOWED\"))\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_ou_placement(\"network\", \"Workloads-OU\")\n",
        "\n",
        "    def test_immutable_logging(self):\n",
        "        self.assertTrue(self.validator.validate_log_archive_immutability(True, \"COMPLIANCE\").startswith(\"ALLOWED\"))\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_log_archive_immutability(True, \"GOVERNANCE\")\n",
        "\n",
        "    def test_service_boundary_naming(self):\n",
        "        self.assertTrue(self.validator.validate_workload_account_boundary(\"payments-ledger-prod\").startswith(\"ALLOWED\"))\n",
        "        with self.assertRaises(ValueError):\n",
        "            self.validator.validate_workload_account_boundary(\"finance-dept-prod\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    suite = unittest.TestLoader().loadTestsFromTestCase(TestChapter13SRAStructure)\n",
        "    result = unittest.TextTestRunner(verbosity=2).run(suite)\n",
        "    if result.wasSuccessful():\n",
        "        print(\"\\nALL CHECKS PASSED: Chapter 13 Dedicated Accounts & OU Architecture Validated!\")"
