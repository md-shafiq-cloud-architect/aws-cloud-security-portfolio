        "        self.assertTrue(self.validator.validate_config_prerequisite_and_waf_logs(True, True).startswith(\"ALLOWED\"))\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_config_prerequisite_and_waf_logs(aws_config_enabled_in_region=False, waf_logs_in_log_archive=True)\n",
        "\n",
        "    def test_scoped_multi_admin_least_privilege(self):\n",
        "        waf_admin_scope = {\n",
        "            \"allowed_ous\": {\"Workloads-OU\"},\n",
        "            \"allowed_regions\": {\"us-east-1\", \"eu-west-1\"},\n",
        "            \"allowed_policy_types\": {\"WAF\", \"SHIELD_ADVANCED\"},\n",
        "        }\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_scoped_admin_action(waf_admin_scope, \"Workloads-OU\", \"us-east-1\", \"WAF\").startswith(\"ALLOWED\")\n",
        "        )\n",
        "        # Blocked when WAF admin tries to alter Network Firewall\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_scoped_admin_action(waf_admin_scope, \"Workloads-OU\", \"us-east-1\", \"NETWORK_FIREWALL\")\n",
        "\n",
        "    def test_central_baseline_vs_local_custom_agility(self):\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_member_account_rule_change(\"ADD_CUSTOM_RULE\", is_central_baseline_rule=False).startswith(\"ALLOWED\")\n",
        "        )\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_member_account_rule_change(\"DELETE\", is_central_baseline_rule=True)\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
