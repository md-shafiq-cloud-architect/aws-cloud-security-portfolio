        "class AWSSRAOrgWideGovernanceValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Organization-Wide Controls:\n",
        "    1. Dual-Scope (*) services must operate in Organization-Wide Delegated mode.\n",
        "    2. Both SCP (Principal boundary) and RCP (Resource boundary) must be active.\n",
        "    3. AWS Firewall Manager must centrally enforce WAF and DNS Firewall baselines.\n",
        "    \"\"\"\n",
        "\n",
        "    DUAL_SCOPE_SERVICES = {\n",
        "        \"aws-config\",\n",
        "        \"security-hub\",\n",
        "        \"guardduty\",\n",
        "        \"systems-manager\",\n",
        "        \"macie\",\n",
        "        \"iam-access-analyzer\",\n",
        "    }\n",
        "\n",
        "    REQUIRED_FMS_POLICIES = {\"waf-baseline\", \"dns-firewall-baseline\", \"vpc-sg-audit\"}\n",
        "\n",
        "    def validate_dual_scope_mode(self, service: str, mode: str, delegated_admin_active: bool) -> str:\n",
        "        if service not in self.DUAL_SCOPE_SERVICES:\n",
        "            raise ValueError(f\"INVALID_SERVICE: '{service}' is not a Dual-Scope (*) SRA service.\")\n",
        "        if mode != \"ORGANIZATION_WIDE\" or not delegated_admin_active:\n",
        "            raise PermissionError(\n",
        "                f\"SILO_RISK: Dual-scope service '{service}' must run in ORGANIZATION_WIDE mode with Delegated Admin.\"\n",
        "            )\n",
        "        return f\"ALLOWED: '{service}' verified in Organization-Wide Dual-Scope mode.\"\n",
        "\n",
        "    def validate_scp_and_rcp_coverage(self, scp_attached: bool, rcp_attached: bool) -> str:\n",
        "        if not scp_attached:\n",
        "            raise PermissionError(\"GOVERNANCE_GAP: Missing SCP (Principal boundary protection).\")\n",
        "        if not rcp_attached:\n",
        "            raise PermissionError(\n",
        "                \"EXFILTRATION_RISK: Missing RCP (Resource boundary against external access).\"\n",
        "            )\n",
        "        return \"ALLOWED: Dual boundary protection (SCP + RCP) active across Organization.\"\n",
        "\n",
        "    def validate_firewall_manager_baseline(self, active_fms_policies: set) -> str:\n",
        "        missing = self.REQUIRED_FMS_POLICIES - active_fms_policies\n",
        "        if missing:\n",
        "            raise AssertionError(f\"EDGE_GAP: Firewall Manager missing baseline policies: {sorted(missing)}\")\n",
        "        return \"ALLOWED: AWS Firewall Manager centrally enforcing WAF, DNS Firewall, and SG policies.\"\n",
        "\n",
        "\n",
