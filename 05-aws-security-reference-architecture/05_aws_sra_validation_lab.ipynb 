        "@dataclass(frozen=True)\n",
        "class IAMResourcesMatrixConfig:\n",
        "    scp_allows: bool\n",
        "    rcp_allows: bool\n",
        "    permissions_boundary_allows: bool\n",
        "    identity_or_machine_policy_allows: bool\n",
        "    resource_policy_allows: bool\n",
        "    central_root_management_active: bool\n",
        "    uses_wildcard_resource_arn: bool\n",
        "    audit_tools_enabled: Set[str]\n",
        "    automated_policy_exception_workflow_active: bool\n",
        "\n",
        "\n",
        "class SRAIAMResourcesMatrixValidator:\n",
        "    \"\"\"Validates AWS SRA 91: 8-Layer IAM Policy Matrix & 4 Defense-in-Depth Recommendations.\"\"\"\n",
        "\n",
        "    REQUIRED_TRIPLE_AUDIT_TOOLS = {\n",
        "        \"IAM_Access_Advisor\",\n",
        "        \"AWS_CloudTrail\",\n",
        "        \"IAM_Access_Analyzer\",\n",
        "    }\n",
        "\n",
        "    def __init__(self, config: IAMResourcesMatrixConfig) -> None:\n",
        "        self.config = config\n",
        "\n",
        "    def evaluate_effective_permission_intersection(self) -> bool:\n",
        "        \"\"\"Evaluates AWS IAM policy intersection: SCP & RCP & Boundary & (Identity/Resource).\"\"\"\n",
        "        return (\n",
        "            self.config.scp_allows\n",
        "            and self.config.rcp_allows\n",
        "            and self.config.permissions_boundary_allows\n",
        "            and (self.config.identity_or_machine_policy_allows or self.config.resource_policy_allows)\n",
        "        )\n",
        "\n",
        "    def validate_governance_and_four_recommendations(self) -> None:\n",
        "        if not self.config.central_root_management_active:\n",
        "            raise PermissionError(\n",
        "                \"SRA IAM Rule: Central Root User Management and IAM Account Access Manager MUST be active.\"\n",
        "            )\n",
        "        if self.config.uses_wildcard_resource_arn:\n",
        "            raise PermissionError(\n",
        "                \"SRA Recommendation 2 Violation: Custom IAM policies MUST scope broad actions to \"\n",
        "                \"specific resource ARNs instead of wildcard '*'.\"\n",
        "            )\n",
        "        missing_audit = self.REQUIRED_TRIPLE_AUDIT_TOOLS - self.config.audit_tools_enabled\n",
        "        if missing_audit:\n",
        "            raise PermissionError(\n",
        "                f\"SRA Recommendation 3 Violation: Missing mandatory audit control(s) {sorted(missing_audit)}.\"\n",
        "            )\n",
        "        if not self.config.automated_policy_exception_workflow_active:\n",
        "            raise ValueError(\n",
        "                \"SRA Recommendation 4 Violation: Implement an automated mechanism to review and \"\n",
        "                \"approve policy exceptions instead of ad-hoc manual overrides.\"\n",
        "            )\n",
        "\n",
        "    def run_all_checks(self) -> Dict[str, object]:\n",
        "        self.validate_governance_and_four_recommendations()\n",
        "        effective_access = self.evaluate_effective_permission_intersection()\n",
        "        return {\n",
        "            \"status\": \"PASSED\",\n",
        "            \"effective_access_granted\": effective_access,\n",
        "            \"compliance\": \"AWS_SRA_IAM_RESOURCES_MATRIX_COMPLIANT\",\n",
        "        }\n",
        "\n",
        "\n",
