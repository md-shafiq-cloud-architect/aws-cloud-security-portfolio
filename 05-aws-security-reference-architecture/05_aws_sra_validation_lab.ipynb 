        "        if not self.config.logs_routed_to_log_archive:\n",
        "            raise PermissionError(\n",
        "                \"SRA Violation: WAF and Shield logs MUST be sent to the central Log Archive account.\"\n",
        "            )\n",
        "\n",
        "    def validate_multi_account_governance(self) -> None:\n",
        "        mode = self.config.deployment_mode.lower()\n",
        "        if mode == \"distributed\" and not self.config.firewall_manager_delegated_admin:\n",
        "            raise PermissionError(\n",
        "                \"SRA Mandatory Rule: Distributed WAF/Shield across Application Accounts MUST be \"\n",
        "                \"governed via AWS Firewall Manager as Delegated Administrator.\"\n",
