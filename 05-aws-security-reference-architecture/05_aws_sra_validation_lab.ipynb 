        "\n",
        "    def validate_artifact_access(self, caller_account_id: str, action: str) -> str:\n",
        "        if action == \"AcceptAgreement\":\n",
        "            if caller_account_id != self.mgmt_account_id:\n",
        "                raise PermissionError(\n",
        "                    \"LEGAL_VIOLATION: AWS Artifact Agreements can ONLY be signed from Management Account.\"\n",
        "                )\n",
        "            return \"ALLOWED: Organization agreement action verified in Management Account.\"\n",
        "\n",
        "        if action == \"GetReport\":\n",
        "            if caller_account_id == self.mgmt_account_id:\n",
        "                raise PermissionError(\n",
        "                    \"SEPARATION_OF_DUTIES: Auditors must download Artifact reports from Security Tooling Account, not Mgmt.\"\n",
        "                )\n",
        "            if caller_account_id != self.security_tooling_account_id:\n",
        "                raise PermissionError(\"UNAUTHORIZED: Artifact report access restricted to Security Tooling Account.\")\n",
        "            return \"ALLOWED: Compliance report accessed cleanly from Security Tooling Account.\"\n",
