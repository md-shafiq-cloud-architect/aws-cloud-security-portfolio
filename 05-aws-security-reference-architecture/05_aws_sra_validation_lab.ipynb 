        "\n",
        "class AWSSRAKMSArchitectureValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 40 (AWS Key Management Service):\n",
        "    1. Enforces Separation of Duties between Key Administrators and Key Cryptographic Users.\n",
        "    2. Prevents single-key reuse across distinct workloads/data tiers.\n",
        "    3. Validates Distributed workload keys (with guardrails) vs Security Tooling keys for Org CloudTrail.\n",
        "    \"\"\"\n",
        "\n",
        "    ADMIN_ACTIONS = {\"kms:Create*\", \"kms:PutKeyPolicy\", \"kms:ScheduleKeyDeletion\", \"kms:DisableKey\"}\n",
        "    CRYPTO_ACTIONS = {\"kms:Encrypt\", \"kms:Decrypt\", \"kms:GenerateDataKey\"}\n",
        "\n",
        "    def __init__(self, security_tooling_id: str):\n",
        "        self.security_tooling_id = security_tooling_id\n",
        "\n",
        "    def validate_key_policy_separation_of_duties(self, principal_role: str, granted_actions: set) -> str:\n",
        "        has_admin = bool(granted_actions.intersection(self.ADMIN_ACTIONS))\n",
        "        has_crypto = bool(granted_actions.intersection(self.CRYPTO_ACTIONS))\n",
        "        if has_admin and has_crypto:\n",
        "            raise PermissionError(\n",
        "                f\"SOD_VIOLATION: Role '{principal_role}' combines Key Admin and Decrypt/Encrypt permissions.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Strict Separation of Duties verified for '{principal_role}'.\"\n",
        "\n",
        "    def validate_key_placement_and_scope(\n",
        "        self, purpose: str, key_owner_account: str, shared_across_apps: bool, audit_logging_active: bool\n",
        "    ) -> str:\n",
        "        if shared_across_apps:\n",
        "            raise ValueError(\"BLAST_RADIUS_VIOLATION: Do not use a single KMS key across multiple distinct workloads.\")\n",
        "        if not audit_logging_active:\n",
        "            raise PermissionError(\"AUDIT_GAP: All KMS key usage MUST be audited via CloudTrail.\")\n",
        "        if purpose == \"org-cloudtrail-logs\" and key_owner_account != self.security_tooling_id:\n",
        "            raise PermissionError(\n",
        "                f\"PLACEMENT_ERROR: Organization CloudTrail KMS key must reside in Security Tooling ({self.security_tooling_id}).\"\n",
        "            )\n",
        "        return f\"ALLOWED: KMS key placement and scope verified for '{purpose}'.\"\n",
        "\n",
        "\n",
        "class TestChapter40AWSKMS(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRAKMSArchitectureValidator(security_tooling_id=\"222222222222\")\n",
        "\n",
        "    def test_key_admin_vs_crypto_user_sod(self):\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_key_policy_separation_of_duties(\"KMS-Key-Admin\", {\"kms:PutKeyPolicy\", \"kms:DisableKey\"}).startswith(\"ALLOWED\")\n",
        "        )\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_key_policy_separation_of_duties(\"Overprivileged-Admin\", {\"kms:PutKeyPolicy\", \"kms:Decrypt\"})\n",
        "\n",
        "    def test_distributed_vs_security_tooling_placement(self):\n",
        "        # Local workload CMK in Member Account\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_key_placement_and_scope(\"payments-db-cmk\", \"777777777777\", False, True).startswith(\"ALLOWED\")\n",
        "        )\n",
        "        # Org CloudTrail CMK in Security Tooling Account\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_key_placement_and_scope(\"org-cloudtrail-logs\", \"222222222222\", False, True).startswith(\"ALLOWED\")\n",
        "        )\n",
        "        # Fails if single key is shared across multiple apps\n",
        "        with self.assertRaises(ValueError):\n",
        "            self.validator.validate_key_placement_and_scope(\"shared-all-apps\", \"777777777777\", shared_across_apps=True, audit_logging_active=True)\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    suite = unittest.TestLoader().loadTestsFromTestCase(TestChapter40AWSKMS)\n",
        "    result = unittest.TextTestRunner(verbosity=2).run(suite)\n",
