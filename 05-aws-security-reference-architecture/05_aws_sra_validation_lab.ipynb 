        "        self.validator = AWSSRADefenseInDepthValidator()\n",
        "\n",
        "    def test_control_layer_placement(self):\n",
        "        self.assertTrue(self.validator.validate_control_placement(\"private-ca\", \"network\").startswith(\"ALLOWED\"))\n",
        "        self.assertTrue(self.validator.validate_control_placement(\"guardduty\", \"principals\").startswith(\"ALLOWED\"))\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_control_placement(\"kms-encryption\", \"network\")\n",
