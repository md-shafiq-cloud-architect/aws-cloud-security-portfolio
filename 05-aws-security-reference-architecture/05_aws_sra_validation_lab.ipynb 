        "class AWSSRAIdentityCenterValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 22 (AWS IAM Identity Center):\n",
        "    1. Enforces day-to-day administration delegation to Shared Services Account.\n",
        "    2. Blocks Delegated Admin from modifying Permission Sets deployed to Management Account.\n",
        "    3. Verifies single active Identity Source rule and SCIM automated provisioning.\n",
        "    \"\"\"\n",
        "\n",
        "    VALID_SOURCES = {\"identity-store\", \"active-directory\", \"external-saml-idp\"}\n",
        "\n",
        "    def __init__(self, mgmt_account_id: str, shared_services_account_id: str):\n",
        "        self.mgmt_account_id = mgmt_account_id\n",
        "        self.shared_services_account_id = shared_services_account_id\n",
        "\n",
        "    def validate_admin_operation(\n",
        "        self, caller_account_id: str, operation: str, targets_mgmt_account: bool = False\n",
        "    ) -> str:\n",
        "        if operation == \"routine-user-assignment\":\n",
        "            if caller_account_id == self.mgmt_account_id:\n",
        "                raise PermissionError(\n",
        "                    \"VIOLATION: Day-to-day SSO administration MUST be delegated to Shared Services Account.\"\n",
        "                )\n",
        "            if caller_account_id != self.shared_services_account_id:\n",
        "                raise PermissionError(\"VIOLATION: Unauthorized caller account for SSO administration.\")\n",
        "            return \"ALLOWED: Routine SSO assignment executed from Shared Services Account.\"\n",
        "\n",
        "        if operation == \"modify-permission-set\" and targets_mgmt_account:\n",
        "            if caller_account_id != self.mgmt_account_id:\n",
        "                raise PermissionError(\n",
        "                    \"PRIVILEGE_ESCALATION_BLOCKED: Permission sets provisioned in Management Account \"\n",
        "                    \"can ONLY be modified from the Management Account.\"\n",
        "                )\n",
        "            return \"ALLOWED: Management-targeted permission set modified by Management Account.\"\n",
        "\n",
        "        return \"ALLOWED: Standard Identity Center operation verified.\"\n",
        "\n",
