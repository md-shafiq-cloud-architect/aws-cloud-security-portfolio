        "class AWSSRAFirewallManagerValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 36 (AWS Firewall Manager):\n",
        "    1. Enforces mandatory AWS Config prerequisite in every active policy region.\n",
        "    2. Validates Scoped Multi-Administrator Least Privilege (OU, Region, Policy Type).\n",
        "    3. Protects central baseline rules from member deletion while allowing local custom rules.\n",
        "    \"\"\"\n",
        "\n",
        "    def validate_config_prerequisite_and_waf_logs(\n",
        "        self, aws_config_enabled_in_region: bool, waf_logs_in_log_archive: bool\n",
        "    ) -> str:\n",
        "        if not aws_config_enabled_in_region:\n",
        "            raise PermissionError(\n",
        "                \"PREREQUISITE_FAILED: AWS Config MUST be enabled in the region before Firewall Manager.\"\n",
        "            )\n",
        "        if not waf_logs_in_log_archive:\n",
        "            raise RuntimeError(\"AUDIT_GAP: Centralized AWS WAF logs should route to Log Archive Account.\")\n",
        "        return \"ALLOWED: Region AWS Config prerequisite and Log Archive WAF logging verified.\"\n",
        "\n",
        "    def validate_scoped_admin_action(\n",
        "        self, admin_scope: dict, target_ou: str, target_region: str, policy_type: str\n",
        "    ) -> str:\n",
        "        if (\n",
        "            target_ou not in admin_scope[\"allowed_ous\"]\n",
        "            or target_region not in admin_scope[\"allowed_regions\"]\n",
        "            or policy_type not in admin_scope[\"allowed_policy_types\"]\n",
        "        ):\n",
        "            raise PermissionError(\n",
        "                f\"SCOPE_VIOLATION: Admin unauthorized for OU='{target_ou}', Region='{target_region}', Type='{policy_type}'.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Scoped admin action verified for '{policy_type}' in '{target_ou}' ({target_region}).\"\n",
        "\n",
        "    def validate_member_account_rule_change(\n",
        "        self, action: str, is_central_baseline_rule: bool\n",
        "    ) -> str:\n",
        "        if is_central_baseline_rule and action in {\"DELETE\", \"BYPASS\"}:\n",
        "            raise PermissionError(\n",
        "                \"BASELINE_LOCKED: Member account cannot delete or bypass central Firewall Manager baseline rules.\"\n",
        "            )\n",
        "        if not is_central_baseline_rule and action == \"ADD_CUSTOM_RULE\":\n",
        "            return \"ALLOWED: Member account added local custom WAF/SG control on top of central baseline.\"\n",
        "        raise ValueError(f\"INVALID_OPERATION: Unsupported rule action '{action}'.\")\n",
        "\n",
        "\n",
        "class TestChapter36FirewallManager(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRAFirewallManagerValidator()\n",
        "\n",
