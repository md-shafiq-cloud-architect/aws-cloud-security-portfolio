        "from typing import Any, Dict, List\n",
        "\n",
        "\n",
        "class AWSOrganizationGuardrailEngine:\n",
        "    \"\"\"Validates Multi-Account OU isolation, Implicit Deny, and SCP Guardrails.\"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        # Simulated AWS Organization OU & Account Hierarchy\n",
        "        self.org_structure = {\n",
        "            \"Security-OU\": [\"acc-security-tooling\", \"acc-log-archive\"],\n",
        "            \"Prod-Workloads-OU\": [\"acc-prod-pci\", \"acc-prod-hipaa\"],\n",
        "            \"Sandbox-Dev-OU\": [\"acc-dev-01\", \"acc-qa-01\"],\n",
        "        }\n",
        "        # Organization-level SCP Guardrails per OU\n",
        "        self.ou_scps = {\n",
        "            \"Prod-Workloads-OU\": {\n",
        "                \"deny_actions\": [\n",
        "                    \"cloudtrail:StopLogging\",\n",
        "                    \"guardduty:DeleteDetector\",\n",
        "                ],\n",
        "                \"allowed_regions\": [\"us-east-1\", \"eu-west-1\"],\n",
        "            },\n",
        "            \"Sandbox-Dev-OU\": {\n",
        "                \"deny_actions\": [\"ec2:RunInstances_GPU\", \"organizations:*\"],\n",
        "                \"allowed_regions\": [\"us-east-1\"],\n",
        "            },\n",
        "        }\n",
        "\n",
        "    def get_account_ou(self, account_id: str) -> str:\n",
        "        for ou, accounts in self.org_structure.items():\n",
        "            if account_id in accounts:\n",
        "                return ou\n",
        "        return \"UNASSIGNED\"\n",
        "\n",
        "    def evaluate_access_request(\n",
        "        self,\n",
        "        account_id: str,\n",
        "        action: str,\n",
        "        region: str,\n",
        "        iam_explicit_allow: bool,\n",
        "    ) -> str:\n",
        "        \"\"\"Enforces AWS Policy Evaluation Logic: Explicit Deny (SCP) -> Implicit Deny -> Explicit Allow.\"\"\"\n",
        "        ou = self.get_account_ou(account_id)\n",
        "        scp = self.ou_scps.get(ou, {})\n",
        "\n",
        "        # 1. SCP Explicit Deny Check (Overrides even Admin IAM Allow)\n",
        "        if action in scp.get(\"deny_actions\", []):\n",
        "            return f\"DENIED_BY_SCP ({ou}: {action} blocked)\"\n",
        "\n",
        "        # 2. SCP Region Restriction Guardrail\n",
        "        allowed_regions = scp.get(\"allowed_regions\", [])\n",
        "        if allowed_regions and region not in allowed_regions:\n",
        "            return f\"DENIED_BY_SCP_REGION ({region} not allowed in {ou})\"\n",
        "\n",
        "        # 3. IAM Implicit Deny Check (Default Deny unless explicitly allowed)\n",
        "        if not iam_explicit_allow:\n",
        "            return \"DENIED_BY_IMPLICIT_DENY (No explicit IAM allow)\"\n",
        "\n",
        "        return f\"ALLOWED ({ou} -> {account_id})\"\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    engine = AWSOrganizationGuardrailEngine()\n",
        "\n",
        "    # Test 1: SCP blocks CloudTrail tampering in PCI Prod Account even if IAM allows\n",
        "    res1 = engine.evaluate_access_request(\n",
        "        \"acc-prod-pci\",\n",
        "        \"cloudtrail:StopLogging\",\n",
        "        \"us-east-1\",\n",
        "        iam_explicit_allow=True,\n",
        "    )\n",
        "    assert \"DENIED_BY_SCP\" in res1, res1\n",
        "\n",
        "    # Test 2: Region guardrail blocks unauthorized region in Sandbox OU\n",
        "    res2 = engine.evaluate_access_request(\n",
        "        \"acc-dev-01\", \"ec2:RunInstances\", \"ap-south-1\", iam_explicit_allow=True\n",
        "    )\n",
        "    assert \"DENIED_BY_SCP_REGION\" in res2, res2\n",
        "\n",
        "    # Test 3: Default Implicit Deny blocks principal without explicit IAM policy\n",
        "    res3 = engine.evaluate_access_request(\n",
        "        \"acc-prod-hipaa\", \"s3:GetObject\", \"us-east-1\", iam_explicit_allow=False\n",
        "    )\n",
        "    assert \"DENIED_BY_IMPLICIT_DENY\" in res3, res3\n",
        "\n",
        "    # Test 4: Valid workload action passes both SCP and IAM checks\n",
        "    res4 = engine.evaluate_access_request(\n",
        "        \"acc-prod-pci\", \"s3:PutObject\", \"us-east-1\", iam_explicit_allow=True\n",
        "    )\n",
        "    assert res4.startswith(\"ALLOWED\"), res4\n",
