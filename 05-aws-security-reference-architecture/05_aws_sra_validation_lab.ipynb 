        "\n",
        "class AWSSRAPrivateCAValidator:\n",
        "    \"\"\"\n",
        "    Validates AWS SRA Chapter 41 (AWS Private CA):\n",
        "    1. Enforces strict account separation between Root CA and Subordinate CA (MUST NOT share account).\n",
        "    2. Validates CA hierarchy depth (<= 5 levels) and AWS RAM self-service sharing.\n",
        "    3. Ensures public-facing TLS certificates use ACM inside the Application Account.\n",
        "    \"\"\"\n",
        "\n",
        "    MAX_CA_HIERARCHY_LEVELS = 5\n",
        "\n",
        "    def __init__(self, security_tooling_id: str):\n",
        "        self.security_tooling_id = security_tooling_id\n",
        "\n",
        "    def validate_ca_account_separation(\n",
        "        self, root_ca_account: str, subordinate_ca_account: str, hierarchy_levels: int\n",
        "    ) -> str:\n",
        "        if root_ca_account != self.security_tooling_id:\n",
        "            raise PermissionError(\n",
        "                f\"PLACEMENT_ERROR: Root CA must be governed in Security Tooling Account ({self.security_tooling_id}).\"\n",
        "            )\n",
        "        if root_ca_account == subordinate_ca_account:\n",
        "            raise PermissionError(\n",
        "                \"CRITICAL_VIOLATION: Root CA and Subordinate CA MUST NOT reside in the same AWS account.\"\n",
        "            )\n",
        "        if hierarchy_levels < 1 or hierarchy_levels > self.MAX_CA_HIERARCHY_LEVELS:\n",
        "            raise ValueError(\n",
        "                f\"HIERARCHY_ERROR: CA chain depth ({hierarchy_levels}) must be between 1 and 5 levels.\"\n",
        "            )\n",
        "        return f\"ALLOWED: Root & Subordinate CA isolated across accounts (Depth: {hierarchy_levels} levels).\"\n",
        "\n",
        "    def validate_certificate_consumption(\n",
        "        self, exposure_type: str, uses_aws_ram: bool, hosted_in_app_account: bool\n",
        "    ) -> str:\n",
        "        if exposure_type == \"INTERNAL_PRIVATE\":\n",
        "            if not uses_aws_ram:\n",
        "                raise RuntimeError(\n",
        "                    \"COST_AND_AGILITY_GAP: Share Subordinate CA via AWS RAM for self-service internal certificates.\"\n",
        "                )\n",
        "            return \"ALLOWED: Internal private TLS enabled via AWS RAM self-service sharing.\"\n",
        "\n",
        "        if exposure_type == \"PUBLIC_INTERNET\":\n",
        "            if not hosted_in_app_account:\n",
        "                raise PermissionError(\n",
        "                    \"PUBLIC_CERT_ERROR: Public-facing ACM certificates must reside inside the Application Account.\"\n",
        "                )\n",
        "            return \"ALLOWED: Public TLS certificate properly hosted via ACM in Application Account.\"\n",
        "\n",
        "        raise ValueError(f\"INVALID_EXPOSURE: Unknown certificate exposure type '{exposure_type}'.\")\n",
        "\n",
        "\n",
        "class TestChapter41AWSPrivateCA(unittest.TestCase):\n",
        "    def setUp(self):\n",
        "        self.validator = AWSSRAPrivateCAValidator(security_tooling_id=\"222222222222\")\n",
        "\n",
        "    def test_root_and_subordinate_ca_account_isolation(self):\n",
        "        res = self.validator.validate_ca_account_separation(\"222222222222\", \"888888888888\", hierarchy_levels=3)\n",
        "        self.assertTrue(res.startswith(\"ALLOWED\"))\n",
        "        # Fails if Root and Subordinate CA are in the same account\n",
        "        with self.assertRaises(PermissionError):\n",
        "            self.validator.validate_ca_account_separation(\"222222222222\", \"222222222222\", hierarchy_levels=2)\n",
        "        # Fails if hierarchy exceeds 5 levels\n",
        "        with self.assertRaises(ValueError):\n",
        "            self.validator.validate_ca_account_separation(\"222222222222\", \"888888888888\", hierarchy_levels=6)\n",
        "\n",
        "    def test_internal_ram_vs_public_acm(self):\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_certificate_consumption(\"INTERNAL_PRIVATE\", uses_aws_ram=True, hosted_in_app_account=False).startswith(\"ALLOWED\")\n",
        "        )\n",
        "        self.assertTrue(\n",
        "            self.validator.validate_certificate_consumption(\"PUBLIC_INTERNET\", uses_aws_ram=False, hosted_in_app_account=True).startswith(\"ALLOWED\")\n",
        "        )\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
