        "\n",
        "class SRABCDRAndFaultIsolationValidator:\n",
        "    \"\"\"Validates AWS SRA Disaster Recovery (RTO/RPO) alignment and 3-tier Fault Isolation.\"\"\"\n",
        "\n",
        "    REQUIRED_ISOLATION_TIERS = {\"Account\", \"AvailabilityZone\", \"Region\"}\n",
        "    # Typical worst-case recovery time (in minutes) for each AWS DR strategy\n",
        "    STRATEGY_TYPICAL_RTO_MINUTES = {\n",
        "        \"backup_and_restore\": 1440,    # Hours\n",
        "        \"pilot_light\": 45,             # Tens of minutes\n",
        "        \"warm_standby\": 10,            # Minutes\n",
        "        \"multi_site_active_active\": 0, # Near real time\n",
        "    }\n",
        "\n",
        "    def __init__(self, config: BCDRAndFaultIsolationConfig) -> None:\n",
        "        self.config = config\n",
        "\n",
        "    def validate_dr_strategy_rto_alignment(self) -> None:\n",
        "        strategy = self.config.selected_dr_strategy.lower()\n",
        "        if strategy not in self.STRATEGY_TYPICAL_RTO_MINUTES:\n",
        "            raise ValueError(f\"Unsupported AWS DR strategy: {self.config.selected_dr_strategy}\")\n",
        "\n",
        "        strategy_rto = self.STRATEGY_TYPICAL_RTO_MINUTES[strategy]\n",
        "        if strategy_rto > self.config.target_rto_minutes:\n",
        "            raise ValueError(\n",
        "                f\"SRA DR Violation: Strategy '{strategy}' has a typical RTO of ~{strategy_rto} mins, \"\n",
        "                f\"which exceeds the workload's strict target RTO of {self.config.target_rto_minutes} mins.\"\n",
        "            )\n",
        "\n",
        "        if self.config.workload_criticality.lower() == \"mission_critical\" and strategy != \"multi_site_active_active\":\n",
        "            raise PermissionError(\n",
        "                \"SRA Resiliency Violation: Mission-critical zero-downtime workloads require \"\n",
        "                \"'multi_site_active_active'.\"\n",
        "            )\n",
        "\n",
        "    def validate_three_tier_fault_isolation(self) -> None:\n",
        "        missing_tiers = self.REQUIRED_ISOLATION_TIERS - self.config.fault_isolation_boundaries\n",
        "        if missing_tiers:\n",
        "            raise PermissionError(\n",
        "                f\"SRA Fault Isolation Violation: Missing mandatory containment boundaries {sorted(missing_tiers)}.\"\n",
